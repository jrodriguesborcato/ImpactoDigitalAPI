# Copie para .env e preencha com suas credenciais reais.
# Nunca envie o arquivo .env para o Git ou para o frontend.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_secret_key

SYNCPAY_BASE_URL=https://api.syncpayments.com.br
SYNCPAY_CLIENT_ID=replace_with_syncpay_client_id
SYNCPAY_CLIENT_SECRET=replace_with_syncpay_client_secret
SYNCPAY_WEBHOOK_SECRET=replace_with_syncpay_webhook_secret

# Frontend local (Vite usa a porta 8443 neste projeto).
FRONTEND_URL=http://localhost:8443
PORT=3001
